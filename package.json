{
  "name": "crud-express-ts",
  "version": "1.0.0",
  "description": "API REST de usuários (CRUD) feita com Node.js, Express e TypeScript.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Eric-Formiga/crud-express-ts.git"
  },
  "keywords": [],
  "author": "Eric Formiga",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Eric-Formiga/crud-express-ts/issues"
  },
  "homepage": "https://github.com/Eric-Formiga/crud-express-ts#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  }
}
